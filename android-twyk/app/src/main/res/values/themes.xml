<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Twyk" parent="android:Theme.Material.NoActionBar">
        <!-- Barra de estado transparente: el vídeo del feed se ve por detrás
             (edge-to-edge), pero la barra sigue visible/intacta. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>

    <!-- BUG reportado por el usuario ("hay 2 splash screen, eliminar el
         primero y dejar el segundo"): tema de ARRANQUE (el que la Activity
         declara en AndroidManifest.xml, leído por installSplashScreen() en
         MainActivity.kt) para el splash del SISTEMA (Android 12+ lo pinta
         SIEMPRE, automáticamente, con o sin este tema — de ahí el "primero"
         que el usuario veía). Fondo BLANCO (no negro, para que se funda sin
         corte con el splash PROPIO de la app -SplashScreen() en
         MainActivity.kt, que también es fondo blanco + logo grande- en vez
         de un salto negro->blanco perceptible como "2 pantallas distintas").
         `postSplashScreenTheme` es el tema que se restaura automáticamente
         en la Activity justo DESPUÉS de que el splash del sistema se
         retire (sin esto, la app se quedaría con el tema del splash puesto
         para siempre). Sin `windowSplashScreenAnimatedIcon` explícito, el
         sistema usa el icono normal de la app (mipmap/ic_launcher) —
         irrelevante en la práctica: installSplashScreen() NO fija ningún
         `setKeepOnScreenCondition` en MainActivity.kt, así que este splash
         del sistema se retira en el instante en que Compose pinta su primer
         frame (casi inmediato, ya que `setContent` se llama nada más
         empezar `onCreate`) — el usuario ya no lo percibe como una
         pantalla propia, solo el splash grande de la app (el "segundo",
         el que se pidió conservar) queda visible el 1.1s completo. -->
    <style name="Theme.Twyk.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="postSplashScreenTheme">@style/Theme.Twyk</item>
    </style>
</resources>
