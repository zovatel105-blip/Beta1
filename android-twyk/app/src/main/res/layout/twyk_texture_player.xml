<?xml version="1.0" encoding="utf-8"?>
<!--
  PlayerView basado en TextureView para las publicaciones 1vs1 (dueto).

  Motivo: un SurfaceView (tipo por defecto de PlayerView) con RESIZE_MODE_ZOOM
  escala el vídeo MÁS GRANDE que su vista y NO se recorta dentro de los límites
  de Compose -> la superficie se desborda sobre la mitad vecina y el 1vs1 se ve
  desbalanceado (p. ej. 29/71 en vertical, 56/44 en horizontal).

  Un TextureView se dibuja dentro de la jerarquía normal de vistas y SÍ se recorta
  a sus límites, por lo que el zoom queda confinado a su mitad (replica el
  object-cover recortado de la web -> split 50/50 limpio).
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="zoom"
    app:shutter_background_color="@android:color/black" />
