{
  "expo": {
    "name": "Twyk",
    "slug": "mobile-twyk",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "twyk",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#000000"
    },
    "android": {
      "package": "com.twyk.mobile"
    },
    "ios": {
      "bundleIdentifier": "com.twyk.mobile",
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ]
    ]
  }
}
